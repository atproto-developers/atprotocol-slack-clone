{
  "lexicon": 1,
  "id": "org.slack.operator.getOperation",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read the status of a journaled operation. The operator revalidates the caller as an active workspace admin.",
      "parameters": {
        "type": "params",
        "required": ["workspace", "operationId"],
        "properties": {
          "workspace": { "type": "string", "format": "space-ref" },
          "operationId": { "type": "string", "format": "tid" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "object", "required": ["operation"], "properties": { "operation": { "type": "ref", "ref": "org.slack.operator.execute#operation" } } }
      },
      "errors": [{ "name": "Unauthorized" }, { "name": "NotFound" }]
    }
  }
}
