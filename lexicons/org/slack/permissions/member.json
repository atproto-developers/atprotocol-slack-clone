{
  "lexicon": 1,
  "id": "org.slack.permissions.member",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Member workspace access",
      "detail": "Read joined workspaces and channels, publish member-owned messages and requests, and write an acceptance marker.",
      "permissions": [
        { "type": "permission", "resource": "space", "spaceType": "org.slack.workspace", "authority": "*", "action": ["read"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.channel", "authority": "*", "action": ["read"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.workspace", "authority": "*", "collection": ["org.slack.acceptance"], "action": ["create", "update"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.inbox", "authority": "*", "collection": ["org.slack.joinRequest"], "action": ["create", "update", "delete"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.channel", "authority": "*", "collection": ["org.slack.channel.message", "org.slack.channel.reaction"], "action": ["create", "update", "delete"] }
      ]
    }
  }
}
