{
  "lexicon": 1,
  "id": "org.slack.permissions.workspaceAuthority",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Workspace authority administration",
      "detail": "Manage the workspace's spaces and authority-owned records. Message and request records remain outside this grant.",
      "permissions": [
        { "type": "permission", "resource": "space", "spaceType": "org.slack.workspace", "skey": "workspace", "action": ["read_self"], "manage": ["update"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.workspace", "skey": "*", "collection": ["org.slack.workspace.profile", "org.slack.directory", "org.slack.workspace.roster", "org.slack.admin"], "action": ["create", "update", "delete"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.inbox", "skey": "inbox", "action": ["read_self"], "manage": ["update"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.inbox", "skey": "inbox", "collection": ["org.slack.joinDecision"], "action": ["create", "update", "delete"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.channel", "skey": "*", "action": ["read_self"], "manage": ["update"] },
        { "type": "permission", "resource": "space", "spaceType": "org.slack.channel", "skey": "*", "collection": ["org.slack.channel.roster"], "action": ["create", "update", "delete"] },
        { "type": "permission", "resource": "rpc", "inheritAud": true, "lxm": ["org.slack.operator.execute", "org.slack.operator.getOperation", "org.slack.operator.listInboxWriters"] }
      ]
    }
  }
}
